{
  "name": "securegate-backend",
  "version": "2.0.0",
  "private": true,
  "description": "SecureGate visitor management API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "JWT_SECRET=test-secret-that-is-long-enough-for-hs256-signing MONGO_URI=mongodb://localhost:27017/securegate-test ALLOW_DEV_OTP=true NODE_ENV=test jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "create-admin": "ts-node src/scripts/createAdmin.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "resend": "^6.38.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/server.ts",
      "!src/scripts/**"
    ],
    "testRunner": "jest-circus/runner"
  },
  "license": "MIT"
}
