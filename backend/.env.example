# SecureGate backend environment
NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/securegate

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Resend email delivery. Required in production.
RESEND_API_KEY=
EMAIL_FROM=SecureGate <onboarding@resend.dev>

# Optional development-only OTP fallback. Never enable in production.
ALLOW_DEV_OTP=false

# Comma-separated browser origins. Native mobile clients do not need CORS.
CORS_ORIGINS=http://localhost:8081

# Invite code required for guard self-registration. Leave empty to disable guard signup.
GUARD_INVITE_CODE=

SOCIETY_NAME=SecureGate Community
SOCIETY_ADDRESS=

TRUST_PROXY=1
