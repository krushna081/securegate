{
  "expo": {
    "name": "SecureGate",
    "slug": "securegate",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./frontend/src/assets/icon.png",
      "backgroundColor": "#6B46C1",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-splash-screen"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.securegate.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow SecureGate to capture visitor photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6B46C1"
      },
      "package": "com.securegate.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "owner": "krushna081s-organization",
    "platforms": [
      "ios",
      "android"
    ]
  }
}
